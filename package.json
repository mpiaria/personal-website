{
  "name": "personal-website",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for personal website with Next.js frontend and AWS CDK infrastructure",
  "workspaces": [
    "infrastructure",
    "packages/ui"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "cdk": "npm run cdk --workspace=infrastructure --",
    "clean": "npm run clean --workspaces --if-present",
    "dev": "npm run dev --workspace=packages/ui",
    "start": "npm run start --workspace=packages/ui",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.1",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "npm-check-updates": "^23.1.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.8.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.2": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
